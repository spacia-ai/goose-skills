{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "goose-skills index.json v1",
  "type": "object",
  "required": ["schema", "version", "skills"],
  "properties": {
    "schema":       { "const": "https://goose-skills.spacia.ai/schemas/index/v1.json" },
    "version":      { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "registry_url": { "type": "string", "format": "uri" },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/SkillEntry" }
    }
  },
  "$defs": {
    "SkillEntry": {
      "type": "object",
      "required": ["name", "path", "description", "extensions", "requires", "files", "files_sha256"],
      "properties": {
        "name":              { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "path":              { "type": "string" },
        "parent":            { "type": "string" },
        "description":       { "type": "string" },
        "extensions":        { "type": "array", "items": { "type": "string" } },
        "requires":          { "type": "array", "items": { "type": "string" } },
        "tools":             { "type": "array", "items": { "type": "string" } },
        "tags":              { "type": "array", "items": { "type": "string" } },
        "min_goose_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/RemoteFile" }
        },
        "files_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "isolated":     { "type": "boolean" }
      }
    },
    "RemoteFile": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path":   { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size":   { "type": "integer", "minimum": 0 }
      }
    }
  }
}
